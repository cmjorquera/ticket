sistema_base.zip

# Configuración privada (credenciales). Nunca versionar.
config_privada.local.php
config_privada/
*.local.php

# Respaldos, volcados y logs
*.zip
*.sql
# ...excepto los scripts de cambios de estructura, que sí se versionan
!sql/*.sql
# ...y los de cada módulo (ej: almuerzos/sql/)
!*/sql/*.sql
*.log
logica/logs/

# Archivo generado en cada despliegue
clases/version_desplegada.json

# Logs de errores de PHP (se generan en el servidor)
error_log

# Fotos subidas por los usuarios: viven solo en el servidor
inventario/uploads/**
!inventario/uploads/**/
!inventario/uploads/**/.gitkeep
# (inventario/uploads/ guarda las de PC, monitores y herramientas.
#  inventario_herramintas/uploads/ es la ubicación antigua: solo en el servidor)
inventario_herramintas/uploads/
